{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trionnemesis/AI-NativeSTDD-VDD/governance/schemas/gate.schema.json",
  "title": "Gate contract",
  "type": "object",
  "required": ["gate_id", "scope", "stage", "assertions"],
  "properties": {
    "gate_id": {"type": "string", "pattern": "^GATE:[A-Z][A-Z0-9_-]*$"},
    "scope": {"enum": ["canonical_pipeline", "upstream", "auxiliary"]},
    "stage": {"type": "string", "minLength": 1},
    "assertions": {"oneOf": [{"type": "array", "minItems": 1}, {"type": "object", "minProperties": 1}]},
    "preconditions": {"oneOf": [{"type": "array"}, {"type": "object"}]},
    "in_canonical_pipeline": {"type": "boolean"}
  },
  "additionalProperties": true
}
